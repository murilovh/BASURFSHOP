---
import Plus from '@lucide/astro/icons/plus';

/**
 * TODO(faq): todas as respostas com `confirmar: true` precisam ser validadas com o Beto antes de publicar.
 */
const perguntas = [
  {
    q: 'Quanto tempo demora um conserto?',
    a: 'Depende do tamanho do estrago. O prazo é combinado junto com o orçamento, antes de começar o serviço.',
    confirmar: true, // prazo medio? existe servico expresso?
  },
  {
    q: 'Que tipos de reparo vocês fazem?',
    a: 'Dings e trincas, bico e rabeta, quilhas e caixas de quilha, entre outros. Manda uma foto no WhatsApp para uma primeira avaliação.',
    confirmar: true, // confirmar lista de reparos (epoxy? prancha partida? lixa/pintura?)
  },
  {
    q: 'Como funciona o aluguel de prancha e roupa?',
    a: 'Você escolhe a prancha e a roupa na loja, retira, surfa e devolve no combinado. Disponibilidade e valores pelo WhatsApp.',
    confirmar: true, // por hora/dia? documento? caucao?
  },
  {
    q: 'Dá para encomendar uma prancha com o Beto?',
    a: 'Dá. O Beto também shapeia. Chama no WhatsApp para conversar sobre o modelo, as medidas e o prazo.',
    confirmar: true, // prazo de encomenda e sinal
  },
  {
    q: 'Quais são as formas de pagamento?',
    a: 'Confirme as formas de pagamento pelo WhatsApp antes de ir.',
    confirmar: true, // TODO: listar (Pix, cartao, dinheiro?)
  },
];
---
<section id="faq" class="py-section" aria-labelledby="faq-titulo">
  <div class="container-page grid gap-10 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-4">
      <h2 id="faq-titulo" class="text-display-lg md:sticky md:top-28" data-split>Dúvidas</h2>
    </div>

    <div class="md:col-span-8" x-data="{ aberta: 0 }">
      <ul class="border-t-2 border-bone/15" role="list">
        {
          perguntas.map((p, i) => (
            <li class="border-b-2 border-bone/15" data-reveal data-todo={p.confirmar ? 'confirmar-com-beto' : undefined}>
              <h3>
                <button
                  type="button"
                  id={`faq-q-${i}`}
                  aria-controls={`faq-a-${i}`}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  x-bind:aria-expanded={`(aberta === ${i}).toString()`}
                  x-on:click={`aberta = aberta === ${i} ? null : ${i}`}
                  class="group flex w-full items-center justify-between gap-6 py-6 text-left font-display text-lg font-bold md:py-7 md:text-xl"
                >
                  {p.q}
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-pill border-2 border-bone/25 transition-[transform,border-color] duration-300 ease-out group-hover:border-bone group-aria-expanded:rotate-45 group-aria-expanded:border-rosa group-aria-expanded:text-rosa">
                    <Plus size={20} strokeWidth={2.25} aria-hidden="true" />
                  </span>
                </button>
              </h3>
              <div
                id={`faq-a-${i}`}
                role="region"
                aria-labelledby={`faq-q-${i}`}
                x-show={`aberta === ${i}`}
                x-collapse
              >
                <p class="max-w-prose pb-7 pr-14 text-mute">{p.a}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
