---
import BrandIcon from './BrandIcon.astro';
import { business, waLinks } from '../data/site';
---
<section class="px-gutter pb-section" aria-labelledby="cta-titulo">
  <div class="mx-auto max-w-page overflow-hidden rounded-board bg-rosa px-6 py-16 text-ink md:px-14 md:py-24">
    <h2 id="cta-titulo" class="max-w-[15ch] text-display-xl" data-split>Chama o Beto no WhatsApp.</h2>
    <p class="mt-6 max-w-prose text-lead font-medium" data-reveal>
      Conserto, prancha, shape, acessório ou aluguel. Manda a mensagem que ele te responde.
    </p>
    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6" data-reveal>
      <a href={waLinks.geral} target="_blank" rel="noopener" class="btn btn-ink">
        <BrandIcon name="whatsapp" size={18} />
        Chamar no WhatsApp
      </a>
      <a href={`tel:${business.phoneE164}`} class="font-display text-lg font-bold underline decoration-2 underline-offset-4">
        {business.phoneDisplay}
      </a>
    </div>
  </div>
</section>
