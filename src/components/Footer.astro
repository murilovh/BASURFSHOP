---
import Mail from '@lucide/astro/icons/mail';
import BrandIcon from './BrandIcon.astro';
import Logo from './Logo.astro';
import { business } from '../data/site';
const ano = new Date().getFullYear();
---
<footer class="border-t border-bone/10 pb-28 pt-16 md:pb-14">
  <div class="container-page grid gap-12 md:grid-cols-12">
    <div class="md:col-span-4">
      <Logo width={180} class="h-auto w-[150px] md:w-[180px]" />
      <p class="mt-6 max-w-[32ch] text-mute">{business.bio}</p>
    </div>

    <address class="not-italic md:col-span-4">
      <h2 class="font-display text-base font-bold">Loja</h2>
      <p class="mt-3 text-mute">
        {business.address.street}<br />
        {business.address.district}, {business.address.city} - {business.address.state}<br />
        CEP {business.address.postalCode}
      </p>
      <a href={`mailto:${business.email}`} class="mt-4 inline-flex items-center gap-2 text-mute underline decoration-bone/30 underline-offset-4 hover:text-bone">
        <Mail size={18} strokeWidth={2} aria-hidden="true" />
        {business.email}
      </a>
    </address>

    <div class="md:col-span-4">
      <h2 class="font-display text-base font-bold">Redes</h2>
      <ul class="mt-3 flex gap-3" role="list">
        <li>
          <a href={business.instagram.url} target="_blank" rel="noopener" class="flex size-12 items-center justify-center rounded-pill border-2 border-bone/20 transition-colors hover:border-bone" aria-label={`Instagram ${business.instagram.handle}`}>
            <BrandIcon name="instagram" size={20} />
          </a>
        </li>
        <li>
          <a href={business.facebook.url} target="_blank" rel="noopener" class="flex size-12 items-center justify-center rounded-pill border-2 border-bone/20 transition-colors hover:border-bone" aria-label="Facebook Beto Alemão Surf Consertos">
            <BrandIcon name="facebook" size={20} />
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="container-page mt-14">
  <div class="flex flex-col gap-2 border-t border-bone/10 pt-6 text-sm text-mute md:flex-row md:justify-between">
    <p>© {ano} {business.name}. Loja do {business.owner}.</p>
    <p>Praia do Rosa, Imbituba - SC</p>
  </div>
  </div>
</footer>
