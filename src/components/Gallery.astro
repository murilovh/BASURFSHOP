---
import BrandIcon from './BrandIcon.astro';
import PhotoSlot from './PhotoSlot.astro';
import { gallery } from '../data/gallery';
import { business } from '../data/site';

const shapeClass = {
  tall: 'md:col-span-3 md:row-span-2 aspect-[4/5] md:aspect-auto',
  wide: 'md:col-span-6 aspect-[16/10] md:aspect-auto',
  square: 'md:col-span-3 aspect-square md:aspect-auto',
  full: 'md:col-span-12 md:row-span-2 aspect-[16/10] md:aspect-auto',
};
---
<section class="py-section" aria-labelledby="galeria-titulo">
  <div class="container-page">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <h2 id="galeria-titulo" class="max-w-[14ch] text-display-lg" data-split>Antes, depois e o dia a dia da loja.</h2>
      <a href={business.instagram.url} target="_blank" rel="noopener" class="btn btn-ghost self-start md:self-auto" data-reveal>
        <BrandIcon name="instagram" size={18} />
        Ver no Instagram
      </a>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-3 md:mt-16 md:grid-cols-12 md:auto-rows-[13rem] md:gap-4" role="list">
      {
        gallery.map((g, i) => (
          <li class:list={[shapeClass[g.shape], i % 3 === 2 ? 'col-span-2' : 'col-span-1']} data-reveal>
            <PhotoSlot src={g.src} alt={g.alt} todo={g.todo} class="h-full w-full" sizes="(min-width: 768px) 33vw, 50vw" />
          </li>
        ))
      }
    </ul>
  </div>
</section>
