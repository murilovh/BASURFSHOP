---
// Logo oficial (arquivo original convertido para fundo transparente, sem redesenho).
import { Image } from 'astro:assets';
import logo from '../assets/logo-ba-white.png';

interface Props {
  width: number;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { width, class: className, loading = 'lazy' } = Astro.props;
---
<Image
  src={logo}
  alt="BA Surfboards"
  width={width}
  class={className}
  loading={loading}
  format="webp"
  densities={[1, 2]}
/>
