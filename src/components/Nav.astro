---
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import Logo from './Logo.astro';
import BrandIcon from './BrandIcon.astro';
import { waLinks } from '../data/site';

const links = [
  { href: '#pranchas', label: 'Pranchas' },
  { href: '#acessorios', label: 'Acessórios' },
  { href: '#conserto', label: 'Consertos' },
  { href: '#aluguel', label: 'Aluguel' },
  { href: '#como-chegar', label: 'Como chegar' },
];
---
<header
  class="fixed inset-x-0 top-0 z-nav border-b border-bone/10 bg-ink/85 backdrop-blur-md"
  x-data="{ open: false }"
  x-effect="window.dispatchEvent(new Event(open ? 'lenis:stop' : 'lenis:start'))"
  @keydown.escape.window="open = false"
>
  <nav class="container-page flex h-nav items-center justify-between gap-6" aria-label="Principal">
    <a href="#topo" class="shrink-0 rounded-md" aria-label="BA Surfboards, voltar ao início">
      <Logo width={112} loading="eager" class="h-auto w-[92px] md:w-[112px]" />
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="text-[0.9375rem] font-semibold text-mute transition-colors hover:text-bone">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href={waLinks.geral} target="_blank" rel="noopener" class="btn btn-primary hidden !min-h-11 !py-2.5 sm:inline-flex">
        <BrandIcon name="whatsapp" size={18} />
        Chamar no WhatsApp
      </a>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-pill border-2 border-bone/25 text-bone transition-colors hover:border-bone lg:hidden"
        @click="open = !open"
        :aria-expanded="open.toString()"
        aria-expanded="false"
        aria-controls="menu-mobile"
      >
        <span class="sr-only" x-text="open ? 'Fechar menu' : 'Abrir menu'">Abrir menu</span>
        <Menu size={20} strokeWidth={2} x-show="!open" aria-hidden="true" />
        <X size={20} strokeWidth={2} x-show="open" x-cloak aria-hidden="true" />
      </button>
    </div>
  </nav>

  <div
    id="menu-mobile"
    x-show="open"
    x-cloak
    x-transition.opacity.duration.250ms
    class="fixed inset-x-0 top-nav h-[calc(100dvh-4.25rem)] bg-ink lg:hidden"
  >
    <ul class="container-page flex flex-col gap-1 pt-8">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              @click="open = false"
              class="block py-3 font-display text-display-md font-extrabold text-bone"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="container-page mt-10">
      <a href={waLinks.geral} target="_blank" rel="noopener" class="btn btn-primary w-full">
        <BrandIcon name="whatsapp" size={18} />
        Chamar no WhatsApp
      </a>
    </div>
  </div>
</header>
