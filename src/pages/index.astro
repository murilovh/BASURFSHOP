---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Proof from '../components/Proof.astro';
import Problem from '../components/Problem.astro';
import Services from '../components/Services.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Gallery from '../components/Gallery.astro';
import Rental from '../components/Rental.astro';
import Location from '../components/Location.astro';
import Faq from '../components/Faq.astro';
import Beto from '../components/Beto.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---
<Base
  title="BA Surfboards | Loja de surf na Praia do Rosa: pranchas, acessórios, conserto e aluguel"
  description="Loja de surf do Beto Alemão no centrinho da Praia do Rosa (Imbituba, SC): pranchas novas e usadas, acessórios, conserto de prancha e aluguel de prancha e roupa."
>
  <Nav />
  <main id="conteudo">
    <Hero />
    <Proof />
    <Services />
    <Problem />
    <HowItWorks />
    <Gallery />
    <Rental />
    <Location />
    <Faq />
    <Beto />
    <FinalCta />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Base>
